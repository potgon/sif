{
  "expo": {
    "name": "SIF - Sistema de Finanzas",
    "slug": "sif-finances",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-v2.png",
    "scheme": "sif-finances",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "description": "Sistema de Finanzas - Aplicación móvil para gestión financiera personal",
    "primaryColor": "#2563eb",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sif.finances"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo-v2.png",
        "backgroundColor": "#2563eb"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.sif.finances",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "softwareKeyboardLayoutMode": "pan"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/logo-v2.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-v2.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2563eb"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "2bf6dbe9-44d9-4a88-a5c9-392d899dec87"
      }
    },
    "owner": "potgon"
  }
}
